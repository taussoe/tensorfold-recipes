# Qwen3.8 Flash Next on this Mac through TensorFold (MLX + Metal), drafting with its own MTP head.
# 80 GB of weights plus 32 GB of hashed n-gram tables: --ple-on-ssd reads the tables from the SSD instead of
# holding them in memory, so a 128 GB Mac has room (TensorFold 0.3.6 measured a 85.6 GiB peak on a 128 GB budget).
ENGINE=tensorfold-mac
RECIPE_NAME=qwen3.8-flash-next-mac
MODEL=Vontra/Qwen3.8-Flash-Next-MLX-4bit-MTP
DRAFTERS=
SERVED_NAME=Qwen3.8-Flash-Next
PORT=8080
# Empty = what TensorFold 0.3.6 fits in memory. A cap keeps memory for the rest of the Mac.
CONTEXT=65536
SERVE_ARGS="--ple-on-ssd"
BENCH_MAX_CONTEXT=65536
BENCH_PREFILL_SIZES=1024,4096,16384,32768
BENCH_CONTEXT_SIZES=32768
STARTUP_TIMEOUT=900
# Reply tokens for a request that names no max_tokens (TensorFold default: 4,096). Agents writing whole files
# with thinking on need more; the server caps it to what the context has left.
MAX_TOKENS=${MAX_TOKENS:-32768}
