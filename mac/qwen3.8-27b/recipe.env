# Qwen3.8-27B on this Mac through TensorFold (MLX + Metal), with the DFlash2 draft model.
ENGINE=tensorfold-mac
RECIPE_NAME=qwen3.8-27b-mac
MODEL=Vontra/Qwen3.8-27B-MLX-4bit
DRAFTERS=z-lab/Qwen3.8-27B-DFlash2
SERVED_NAME=Qwen3.8-27B
PORT=8080
# Empty = the model's window. A cap keeps memory for the rest of the Mac.
CONTEXT=65536
SERVE_ARGS=
BENCH_MAX_CONTEXT=65536
# Prefill runs at ~100-150 tok/s on an M3 Max, so the 32k step alone takes ~15 minutes; drop it for quick runs.
BENCH_PREFILL_SIZES=1024,4096,16384,32768
STARTUP_TIMEOUT=600
# Reply tokens for a request that names no max_tokens (TensorFold default: 4,096). Agents writing whole files
# with thinking on need more; the server caps it to what the context has left.
MAX_TOKENS=${MAX_TOKENS:-32768}
