# Qwen3.8-27B (dense) on one or two DGX Sparks through TensorFold's CUDA engine, DFlash2 draft trees.
#   ./start.sh              two Sparks (fastest: 76-82 tok/s code)
#   NODES=1 ./start.sh      one Spark (49 tok/s code), the other Spark stays free
ENGINE=tensorfold-spark
SUPPORTED_NODES="1 2"
NODES=2

MODEL=Vontra/Qwen3.8-27B-MLX-4bit
DRAFTERS=z-lab/Qwen3.8-27B-DFlash2
SERVED_NAME=Qwen3.8-27B

# Empty = the model's own window (262,144). Set a cap if you want the memory for something else.
CONTEXT=
# Several requests at once: PARALLEL=8 decodes up to 8 together (up to 16). Measured on two Sparks: 236 tok/s together
# at 8 streams, each with a 147k context.
PARALLEL=${PARALLEL:-}
SERVE_ARGS="${PARALLEL:+--parallel $PARALLEL}"
BENCH_MAX_CONTEXT=32768
STARTUP_TIMEOUT=900
# Reply tokens for a request that names no max_tokens (TensorFold default: 4,096). Agents writing whole files
# with thinking on need more; the server caps it to what the context has left.
MAX_TOKENS=${MAX_TOKENS:-32768}
