# GLM-5.3-Flash on two DGX Sparks through TensorFold's CUDA engine. Every value can be overridden per run:
#   CONTEXT=65536 ./start.sh
ENGINE=tensorfold-spark
SUPPORTED_NODES="2"              # 182 GB of 4-bit weights: one Spark (128 GB) cannot hold it
NODES=2

MODEL=Vontra/GLM-5.3-Flash-MLX-4bit-MTP
SERVED_NAME=GLM-5.3-Flash

# DFlash2 draft model: +25% on greedy code, +10% on greedy chat (TensorFold's measurements), but it is
# CC BY-NC-ND 4.0 = NON-COMMERCIAL use only. Set to 1 only if those terms fit how you use it.
ACCEPT_NONCOMMERCIAL_DRAFTER=${ACCEPT_NONCOMMERCIAL_DRAFTER:-0}
DRAFTERS=$([ "${ACCEPT_NONCOMMERCIAL_DRAFTER}" = 1 ] && echo incoai/GLM-5.3-Flash-DFlash2 || true)
# Without the drafter on both Sparks, TensorFold must be told explicitly (the ranks compare their settings).
# Several requests at once (agents working in parallel): PARALLEL=4 decodes up to 4 together, each with CONTEXT
# tokens of its own (MTP drafts only, no DFlash2). Measured with PARALLEL=4 CONTEXT=65536: 122 tok/s together at
# 4 streams, 33 tok/s each (vLLM: 62 together). Empty: one request at a time, the full CONTEXT, CUDA graphs.
PARALLEL=${PARALLEL:-}
SERVE_ARGS="$([ "${ACCEPT_NONCOMMERCIAL_DRAFTER}" = 1 ] && [ -z "$PARALLEL" ] || echo "--drafter none")${PARALLEL:+ --parallel $PARALLEL}"

# Write each rank's half once (./pull.sh): a rank loads 91 GB instead of reading 182, and with
# WEIGHTS_SYNC=rsync Spark 2 only ever receives its 91 GB half.
RANK_SPLIT=1

# Prompt + reply tokens. 458,752 (448k): tested with a 449k prompt beside the vision tower (needle found, >= 12 GB
# left on each Spark). Our engine/ branch keeps GLM's attention cache as its 512-wide latent (about 21 KB a token per
# Spark with the indexer and prompt scratch); 0 lets TensorFold allocate what fits (465,768 on our Sparks with image
# input and TF_GLM_CACHE_GIB=1). Past 2,051 tokens DSA's sparse path runs.
# With PARALLEL, CONTEXT is each stream's (default 65,536: four 64k streams fit where one 262k does).
CONTEXT=$([ -n "$PARALLEL" ] && echo 65536 || echo 458752)
BENCH_MAX_CONTEXT=$CONTEXT
STARTUP_TIMEOUT=1800

# Engine settings of our engine/ branch (both ranks get the same):
#   TF_GLM_PREFILL_ROWS  tokens per prefill chunk (TensorFold 0.3.5: 2048, sized into its memory estimate).
#   TF_GLM_LATENT        1 (default): the 512-wide latent attention cache. 0: the per-head cache (dense window only).
#   TF_GLM_CACHE_GIB     memory for kept conversations (TensorFold's default 3; here 1, leaving 2 GiB more for the
#                        context; the current conversation always resumes); TF_GLM_CACHE_ENTRIES how many (default 8).
#   TF_GLM_PROFILE       1: print where each prefill spends its time (syncs the GPU: for measuring only).
#   TF_GLM_DISK_DIR      every prompt's rows also on disk (only the rows it adds to the one before), so a conversation
#                        that left the GPU, or one from before a restart, resumes in seconds; TF_GLM_DISK_GIB caps it.
#   TF_GLM_LOOKUP        1: a round whose last tokens stand earlier in the context verifies what followed them there
#                        (a model rewriting a file or quoting code); 0: MTP drafts only.
ENGINE_ENV="TF_GLM_PREFILL_ROWS=${TF_GLM_PREFILL_ROWS:-2048} TF_GLM_CACHE_GIB=${TF_GLM_CACHE_GIB:-1} TF_GLM_DISK_DIR=${TF_GLM_DISK_DIR:-/root/.cache/huggingface/tensorfold-prompts/glm-5.3-flash} TF_GLM_DISK_GIB=${TF_GLM_DISK_GIB:-64} TF_GLM_LOOKUP=${TF_GLM_LOOKUP:-1}"
# Reply tokens for a request that names no max_tokens (TensorFold default: 4,096). Agents writing whole files
# with thinking on need more; the server caps it to what the context has left.
MAX_TOKENS=${MAX_TOKENS:-32768}
