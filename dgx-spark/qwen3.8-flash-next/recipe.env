# Qwen3.8 Flash Next (512-expert MoE with an MTP head) on one or two DGX Sparks through TensorFold's CUDA engine.
#   ./start.sh              two Sparks (96-104 tok/s)
#   NODES=1 ./start.sh      one Spark (60-73 tok/s; 80 GB weights + 32 GB n-gram tables in page cache = tight)
ENGINE=tensorfold-spark
SUPPORTED_NODES="1 2"
NODES=2

MODEL=Vontra/Qwen3.8-Flash-Next-MLX-4bit-MTP
DRAFTERS=
SERVED_NAME=Qwen3.8-Flash-Next

# Prompt + reply tokens. Empty: TensorFold 0.3.5 allocates what fits (measured: 157,607 on one Spark).
CONTEXT=
# Most MTP drafts a round (TensorFold's CUDA default is 6, and a chain stops under 30% confidence).
# Several requests at once: PARALLEL=8 decodes up to 8 together (TensorFold 0.3.6 runs Flash Next's concurrent
# streams on one GPU: use it with NODES=1). Measured on one Spark: 181 tok/s together at 8 streams, 32k context each.
PARALLEL=${PARALLEL:-}
SERVE_ARGS="${PARALLEL:+--parallel $PARALLEL}"
BENCH_MAX_CONTEXT=157000
BENCH_CONTEXT_SIZES=32768,131072

# Engine settings (both ranks get the same); TensorFold 0.3.5's own prefill path needs none.
ENGINE_ENV=
STARTUP_TIMEOUT=900
# Reply tokens for a request that names no max_tokens (TensorFold default: 4,096). Agents writing whole files
# with thinking on need more; the server caps it to what the context has left.
MAX_TOKENS=${MAX_TOKENS:-32768}
